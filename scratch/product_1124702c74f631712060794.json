              const OverlayManager = {
                  config: {
                      zIndex: 9999,
                      overlayId: 'click-disable-overlay'
                  },

                  createOverlay: function() {
                      const existingOverlay = document.getElementById(this.config.overlayId);
                      if (existingOverlay) {
                          return existingOverlay;
                      }

                      const overlay = document.createElement('div');
                      overlay.id = this.config.overlayId;
                      
                      const styles = {
                          position: 'fixed',
                          top: '0',
                          left: '0',
                          width: '100%',
                          height: '100%',
                          backgroundColor: 'rgba(0, 0, 0, 0)', // Completely transparent
                          zIndex: this.config.zIndex.toString(),
                          pointerEvents: 'auto', // Ensures overlay catches all events
                      };

                      Object.assign(overlay.style, styles);

                      // Prevent all events
                      const eventHandler = (e) => {
                          e.preventDefault();
                          e.stopPropagation();
                          e.stopImmediatePropagation();
                      };

                      overlay.addEventListener('click', eventHandler, true);

                      return overlay;
                  },

                  show: function() {
                      const overlay = this.createOverlay();
                      if (!overlay.parentElement) {
                          document.body.appendChild(overlay);
                      }
                      overlay.style.setProperty('display', 'block', 'important');
                  },

                  hide: function() {
                      const overlay = document.getElementById(this.config.overlayId);
                      if (overlay) {
                          overlay.style.display = 'none';
                      }
                  },

                  initialize: function() {
                      // Show overlay when document is loaded
                      document.addEventListener('DOMContentLoaded', () => {
                          this.show();
                      });

                      // Listen for show/hide events
                      window.addEventListener('showOverlay', () => {
                          this.show();
                      });

                      window.addEventListener('hideOverlay', () => {
                          this.hide();
                      });
                  }
              };

              // Initialize when the script loads
              OverlayManager.initialize();

              // Make it globally available
              window.OverlayManager = OverlayManager;
